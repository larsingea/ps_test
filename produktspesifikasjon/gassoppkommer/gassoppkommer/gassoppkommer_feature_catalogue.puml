@startuml
' For wide diagrams, render with: plantuml -DPLANTUML_LIMIT_SIZE=16384 ...
' The 'scale max' directive below caps the rendered output to prevent the
' default PlantUML 4096px size limit from cropping the diagram.
scale max 4000*4000

title Gassoppkommer - Gassoppkommer - Objekttyper

skinparam backgroundColor #F5F5F5
skinparam shadowing false
skinparam RoundCorner 6
skinparam ArrowColor #6C8198
skinparam wrapWidth 200
skinparam class {
  BackgroundColor #FBF2E8
  BorderColor #9C8578
  FontColor #2D201A
  HeaderBackgroundColor #EFE1D6
  HeaderFontColor #2D201A
  AttributeIconSize 0
}
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #6C8198
  FontColor #2D201A
}
skinparam stereotypeCBackgroundColor #EAD9CE
skinparam stereotypeCBorderColor #9C8578
skinparam stereotypeCFontColor #2D201A

package "Objekttyper" {

  class MarinGassoppkommePkt <<featureType>> {
    + lokalid [0..1] : CharacterString
    + identifikasjon [1..1] : Identifikasjon
    + datafangstdato [1..1] : DateTime
    + oppdateringsdato [0..1] : DateTime
    + datauttaksdato [0..1] : DateTime
    + kvalitet [1..1] : Posisjonskvalitet
    + medium [1..1] : Medium
    + opphav [1..1] : CharacterString
    + toktNummer [1..1] : CharacterString
    + linjeNummer [1..1] : CharacterString
    + datafangsttid [0..1] : CharacterString
    + vanndyp [1..1] : CharacterString
    + gassøyleHøyde [1..1] : Integer
    + styrke [1..1] : Integer
    + pålitelighetProsent [1..1] : Integer
    + geolPavisningstype [1..1] : GeolPavisningstype

    ..Geometri..
    + geometry [1] : GM_Point
  }

  class Identifikasjon <<dataType>> {
    + lokalId [0..1] : CharacterString
    + navnerom [0..1] : CharacterString
    + versjonId [0..1] : CharacterString
  }

  class Posisjonskvalitet <<dataType>> {
    + målemetode [0..1] : CharacterString
    + nøyaktighet [0..1] : Integer
  }
}

@enduml
