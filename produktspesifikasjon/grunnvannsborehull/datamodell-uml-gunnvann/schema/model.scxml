     <sc:properties>
      <sc:Property>
       <sc:name>Åpen</sc:name>
       <sc:id>C23_1</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>grunnvannsoverflaten står i direkte kontakt med atmosfæren, og dermed har akvifærisk trykk</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>1</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Lukket</sc:name>
       <sc:id>C23_2</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>grunnvann under hydrostatisk trykk av overliggende tette masser</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>2</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Artesisk</sc:name>
       <sc:id>C23_3</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>lukket akvifer der den piezometriske overflaten er jordoverflaten</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>3</sc:sequenceNumber>
      </sc:Property>
     </sc:properties>
    </sc:Class>
