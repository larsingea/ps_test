  <element name="GrunnvannOppkomme" substitutionGroup="datamodellumlgunnvann:FellesegenskaperGrunnvannBorehull" type="datamodellumlgunnvann:GrunnvannOppkommeType">
    <annotation>
      <documentation>forekomst av oppkomme/kilde/ naturlig utstrømmende grunnvann</documentation>
    </annotation>
  </element>
  <complexType name="GrunnvannOppkommeType">
    <complexContent>
      <extension base="datamodellumlgunnvann:FellesegenskaperGrunnvannBorehullType">
        <sequence>
          <element name="posisjon" type="gml:PointPropertyType">
            <annotation>
              <documentation>objektet har punktgeometri</documentation>
            </annotation>
          </element>
          <element name="oppkomNr" type="integer">
            <annotation>
              <documentation>oppkommets nummer i Nasjonal Grunnvannsdatabase</documentation>
              <appinfo>
                <sc:taggedValue tag="SOSI_navn">OPPKOMNR</sc:taggedValue>
              </appinfo>
            </annotation>
          </element>
          <element name="geolMedium" type="gml:CodeType">
            <annotation>
              <documentation>definerer om et borehull er boret slik at den blir permanent åpen; et stykke ned i fjellgrunnen (fjell) eller kun i løsmasser (løsmasse).

I dette tilfellet definerer den om et oppkommet forekommer i løsmasse eller i fjell</documentation>
              <appinfo>
                <sc:taggedValue tag="SOSI_navn">GEOLMEDIUM</sc:taggedValue>
              </appinfo>
            </annotation>
          </element>
          <element minOccurs="0" name="oppkomVannføring" type="double">
            <annotation>
              <documentation>oppkommets vanngiverevne målt i liter/time målt ved registrering. (vil variere)</documentation>
              <appinfo>
                <sc:taggedValue tag="SOSI_navn">OPPKOMVANNFORING</sc:taggedValue>
              </appinfo>
            </annotation>
          </element>
          <element minOccurs="0" name="oppkomBruk" type="gml:CodeType">
            <annotation>
              <documentation>overordnet bruksområde for naturlig oppkomme (kilde)</documentation>
              <appinfo>
                <sc:targetCodeListURI>http://skjema.geonorge.no/legg_inn_riktig_url</sc:targetCodeListURI>
                <sc:taggedValue tag="SOSI_navn">OPPKOMBRUK</sc:taggedValue>
              </appinfo>
            </annotation>
          </element>
          <element minOccurs="0" name="oppkomBrukOmfang" type="gml:CodeType">
            <annotation>
              <documentation>underordnet bruksområde (til enkelthusholdning, gårdsbruk osv.)</documentation>
              <appinfo>
                <sc:taggedValue tag="SOSI_navn">OPPKOMBRUKOMFANG</sc:taggedValue>
              </appinfo>
            </annotation>
          </element>
          <element minOccurs="0" name="oppkomUtforming" type="gml:CodeType">
            <annotation>
              <documentation>beskriver om oppkomme er naturlig uten inngrep, eller lagt i rør/kum</documentation>
              <appinfo>
                <sc:taggedValue tag="SOSI_navn">OPPKOMUTFORMING</sc:taggedValue>
              </appinfo>
            </annotation>
          </element>
          <element minOccurs="0" name="oppkomBeskyttelse" type="gml:CodeType">
            <annotation>
              <documentation>beskriver hvordan oppkommet evnt er besyttet (drenering, gjerde, overbygg)</documentation>
              <appinfo>
                <sc:taggedValue tag="SOSI_navn">OPPKOMBESKYTTELSE</sc:taggedValue>
              </appinfo>
            </annotation>
          </element>
