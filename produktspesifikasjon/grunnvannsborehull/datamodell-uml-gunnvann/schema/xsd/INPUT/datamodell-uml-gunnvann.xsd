  <element name="EnergiBrønn" substitutionGroup="datamodellumlgunnvann:GrunnvannBorehull" type="datamodellumlgunnvann:EnergiBrønnType">
    <annotation>
      <documentation>Grunnvannborehull som helt eller delvis er dedikert for uttak eller deponering av grunnvarme, enten gjennom kollektorslanger eller pumping av grunnvann hvis temperatur benyttes til oppvarming eller avkjøling.</documentation>
    </annotation>
  </element>
