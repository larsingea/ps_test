              <appinfo>
                <sc:taggedValue tag="SOSI_navn">BRONNPARKNR</sc:taggedValue>
              </appinfo>
            </annotation>
          </element>
          <element minOccurs="0" name="brønnpark" type="datamodellumlgunnvann:BrønnParkPropertyType"/>
        </sequence>
      </extension>
    </complexContent>
  </complexType>
