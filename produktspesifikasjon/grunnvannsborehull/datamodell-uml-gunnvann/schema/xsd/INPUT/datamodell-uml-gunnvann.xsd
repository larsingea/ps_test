  <element name="BrønnPark" substitutionGroup="datamodellumlgunnvann:FellesegenskaperGrunnvannBorehull" type="datamodellumlgunnvann:BrønnParkType">
    <annotation>
      <documentation>anlegg for uttak og/eller deponering av grunnvarme. Anlegg må ha tilsluttet minst fem energibrønner for å falle inn under NGUs definisjon av "Brønnpark".</documentation>
    </annotation>
  </element>
  <complexType name="BrønnParkType">
    <complexContent>
      <extension base="datamodellumlgunnvann:FellesegenskaperGrunnvannBorehullType">
        <sequence>
          <element name="posisjon" type="gml:PointPropertyType">
            <annotation>
              <documentation>objektet har punktgeometri</documentation>
            </annotation>
          </element>
          <element name="brønnParkNr" type="integer">
            <annotation>
              <documentation>brønnparknummer  i NGUs database</documentation>
              <appinfo>
                <sc:taggedValue tag="SOSI_navn">BRONNPARKNR</sc:taggedValue>
              </appinfo>
            </annotation>
          </element>
          <element minOccurs="0" name="brønnpOmrNavn" type="string">
            <annotation>
              <documentation>lokalt stedsnavn der brønnparken ligger.</documentation>
              <appinfo>
                <sc:taggedValue tag="SOSI_navn">BRONNPOMRNAVN</sc:taggedValue>
              </appinfo>
            </annotation>
          </element>
          <element name="geolMedium" type="gml:CodeType">
            <annotation>
              <documentation>definerer om et borehull er boret slik at den blir permanent åpen; et stykke ned i fjellgrunnen (fjell) eller kun i løsmasser (løsmasse).

I dette tilfellet definerer den om brønnpark er basert på boringer kun i løsmasse (vanligvis for oppumping av varmt grunnvann) eller også er  boret videre ned i berggrunn (vanligvis varmeuttak via kollektorslanger).</documentation>
              <appinfo>
                <sc:taggedValue tag="SOSI_navn">GEOLMEDIUM</sc:taggedValue>
              </appinfo>
            </annotation>
          </element>
          <element name="antallEnergiBrønner" type="integer">
            <annotation>
              <documentation>beskriver antall energibrønner i brønnparken (minimum 5 for å defineres som brønnpark)</documentation>
              <appinfo>
                <sc:taggedValue tag="SOSI_navn">ANTALLENERGIBRONNER</sc:taggedValue>
              </appinfo>
            </annotation>
          </element>
          <element minOccurs="0" name="brønnpKommentar" type="string">
            <annotation>
              <documentation>brønnboreres kommentarer om brønnparken</documentation>
              <appinfo>
                <sc:taggedValue tag="SOSI_navn">BRONNPKOMMENTAR</sc:taggedValue>
              </appinfo>
            </annotation>
          </element>
          <element minOccurs="0" name="brønnpVEffekt" type="integer">
            <annotation>
              <documentation>brønnparkens maksimale varmeeffekt i kW</documentation>
              <appinfo>
                <sc:taggedValue tag="SOSI_navn">BRONNPVEFFEKT</sc:taggedValue>
              </appinfo>
            </annotation>
          </element>
          <element minOccurs="0" name="brønnpVEnergi" type="integer">
            <annotation>
              <documentation>brønnparkens maksimale varmeenergi i kWh/år</documentation>
              <appinfo>
                <sc:taggedValue tag="SOSI_navn">BRONNPVENERGI</sc:taggedValue>
              </appinfo>
            </annotation>
          </element>
          <element minOccurs="0" name="brønnpKEffekt" type="integer">
            <annotation>
              <documentation>brønnparkens maksimale kjøleeffekt i kW</documentation>
              <appinfo>
                <sc:taggedValue tag="SOSI_navn">BRONNPKEFFEKT</sc:taggedValue>
              </appinfo>
            </annotation>
          </element>
          <element minOccurs="0" name="brønnpKEnergi" type="integer">
            <annotation>
              <documentation>brønnparkens maksimale kjøleeffekt i kWh/år</documentation>
              <appinfo>
                <sc:taggedValue tag="SOSI_navn">BRONNPKENERGI</sc:taggedValue>
              </appinfo>
            </annotation>
          </element>
          <element minOccurs="0" name="brønnpFrikjøling" type="string">
            <annotation>
              <documentation>beskriver om brønnparken benyttes til frikjøling (ja/nei)</documentation>
              <appinfo>
                <sc:taggedValue tag="SOSI_navn">BRONNPFRIKJOLING</sc:taggedValue>
              </appinfo>
            </annotation>
          </element>
          <element minOccurs="0" name="brønnpKollVæske" type="gml:CodeType">
            <annotation>
              <documentation>beskriver type kollektorvæske (Metanol osv)</documentation>
              <appinfo>
                <sc:taggedValue tag="SOSI_navn">BRONNPKOLLVESKE</sc:taggedValue>
              </appinfo>
            </annotation>
          </element>
          <element minOccurs="0" name="brønnpFiler" type="string">
            <annotation>
              <documentation>link til eventuelle filer som er knyttet til brønnparken</documentation>
              <appinfo>
                <sc:taggedValue tag="SOSI_navn">BRONNPFILER</sc:taggedValue>
              </appinfo>
            </annotation>
          </element>
          <element maxOccurs="unbounded" minOccurs="5" name="energibrønn" type="datamodellumlgunnvann:EnergiBrønnPropertyType"/>
        </sequence>
      </extension>
    </complexContent>
  </complexType>
  <complexType name="BrønnParkPropertyType">
    <sequence minOccurs="0">
      <element ref="datamodellumlgunnvann:BrønnPark"/>
    </sequence>
