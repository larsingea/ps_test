<?xml version="1.0" encoding="UTF-8"?><schema xmlns="http://www.w3.org/2001/XMLSchema" xmlns:datamodellumlgunnvann="https://skjema.geonorge.no/SOSI/produktspesifikasjon/grunnvannsborehull/datamodell-uml-gunnvann/1.0" xmlns:gml="http://www.opengis.net/gml/3.2" xmlns:sc="http://www.interactive-instruments.de/ShapeChange/AppInfo" elementFormDefault="qualified" targetNamespace="https://skjema.geonorge.no/SOSI/produktspesifikasjon/grunnvannsborehull/datamodell-uml-gunnvann/1.0" version="1.0">
