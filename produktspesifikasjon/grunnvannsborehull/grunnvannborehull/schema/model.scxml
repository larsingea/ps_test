   <sc:classes>
    <sc:Class>
     <sc:name>BrønnPark</sc:name>
     <sc:id>C1</sc:id>
     <sc:stereotypes>
      <sc:Stereotype>featuretype</sc:Stereotype>
     </sc:stereotypes>
     <sc:descriptors>
      <sc:documentation>
       <sc:descriptorValues>
        <sc:DescriptorValue>Anlegg for uttak og/eller deponering av grunnvarme. Anlegg må ha tilsluttet minst fem energibrønner for å falle inn under NGUs definisjon av "Brønnpark".</sc:DescriptorValue>
       </sc:descriptorValues>
      </sc:documentation>
     </sc:descriptors>
     <sc:properties>
      <sc:Property>
       <sc:name>geometry</sc:name>
       <sc:id>C1_1</sc:id>
       <sc:cardinality>1</sc:cardinality>
       <sc:sequenceNumber>1</sc:sequenceNumber>
       <sc:typeName>GM_Point</sc:typeName>
      </sc:Property>
      <sc:Property>
       <sc:name>datauttaksdato</sc:name>
       <sc:id>C1_2</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Dato for uttak fra en database&lt;br/&gt;Merknad:&lt;br/&gt;Skiller seg fra Kopidato ved at en ikke skiller på om det er uttak fra en originaldatabase eller en kopidatabase.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:cardinality>1</sc:cardinality>
       <sc:sequenceNumber>2</sc:sequenceNumber>
       <sc:typeName>DateTime</sc:typeName>
      </sc:Property>
      <sc:Property>
       <sc:name>brønnParkNr</sc:name>
       <sc:id>C1_3</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Brønnparknummer  i NGUs database</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:cardinality>1</sc:cardinality>
       <sc:sequenceNumber>3</sc:sequenceNumber>
       <sc:typeName>Integer</sc:typeName>
      </sc:Property>
      <sc:Property>
       <sc:name>brønnpOmrNavn</sc:name>
       <sc:id>C1_4</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Lokalt stedsnavn der brønnparken ligger.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:cardinality>0..1</sc:cardinality>
       <sc:sequenceNumber>4</sc:sequenceNumber>
       <sc:typeName>CharacterString</sc:typeName>
      </sc:Property>
      <sc:Property>
       <sc:name>geolMedium</sc:name>
       <sc:id>C1_5</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Definerer om et borehull er boret slik at den blir permanent åpen; et stykke ned i fjellgrunnen (fjell) eller kun i løsmasser (løsmasse).
&lt;br/&gt;I dette tilfellet definerer den om brønnpark er basert på boringer kun i løsmasse (vanligvis for oppumping av varmt grunnvann) eller også er  boret videre ned i berggrunn (vanligvis varmeuttak via kollektorslanger).</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:cardinality>1</sc:cardinality>
       <sc:sequenceNumber>5</sc:sequenceNumber>
       <sc:typeId>C10</sc:typeId>
       <sc:typeName>GeolMedium</sc:typeName>
      </sc:Property>
      <sc:Property>
       <sc:name>antallEnergiBrønner</sc:name>
       <sc:id>C1_6</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Beskriver antall energibrønner i brønnparken (minimum 5 for å defineres som brønnpark)</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:cardinality>1</sc:cardinality>
       <sc:sequenceNumber>6</sc:sequenceNumber>
       <sc:typeName>Integer</sc:typeName>
      </sc:Property>
      <sc:Property>
       <sc:name>brønnpKommentar</sc:name>
       <sc:id>C1_7</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Brønnboreres kommentarer om brønnparken</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:cardinality>0..1</sc:cardinality>
       <sc:sequenceNumber>7</sc:sequenceNumber>
       <sc:typeName>CharacterString</sc:typeName>
      </sc:Property>
      <sc:Property>
       <sc:name>brønnpVEffekt</sc:name>
       <sc:id>C1_8</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Brønnparkens maksimale varmeeffekt i kW</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:cardinality>0..1</sc:cardinality>
       <sc:sequenceNumber>8</sc:sequenceNumber>
       <sc:typeName>Integer</sc:typeName>
      </sc:Property>
      <sc:Property>
       <sc:name>brønnpVEnergi</sc:name>
       <sc:id>C1_9</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Brønnparkens maksimale varmeenergi i kWh/år</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:cardinality>0..1</sc:cardinality>
       <sc:sequenceNumber>9</sc:sequenceNumber>
       <sc:typeName>Integer</sc:typeName>
      </sc:Property>
      <sc:Property>
       <sc:name>brønnpKEffekt</sc:name>
       <sc:id>C1_10</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Brønnparkens maksimale kjøleeffekt i kW</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:cardinality>0..1</sc:cardinality>
       <sc:sequenceNumber>10</sc:sequenceNumber>
       <sc:typeName>Integer</sc:typeName>
      </sc:Property>
      <sc:Property>
       <sc:name>brønnpKEnergi</sc:name>
       <sc:id>C1_11</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Brønnparkens maksimale kjøleeffekt i kWh/år</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:cardinality>0..1</sc:cardinality>
       <sc:sequenceNumber>11</sc:sequenceNumber>
       <sc:typeName>Integer</sc:typeName>
      </sc:Property>
      <sc:Property>
       <sc:name>brønnpFrikjøling</sc:name>
       <sc:id>C1_12</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Beskriver om brønnparken benyttes til frikjøling (ja/nei)</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:cardinality>0..1</sc:cardinality>
       <sc:sequenceNumber>12</sc:sequenceNumber>
       <sc:typeName>CharacterString</sc:typeName>
      </sc:Property>
      <sc:Property>
       <sc:name>brønnpKollVæske</sc:name>
       <sc:id>C1_13</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Beskriver type kollektorvæske (Metanol osv)</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:cardinality>0..1</sc:cardinality>
       <sc:sequenceNumber>13</sc:sequenceNumber>
       <sc:typeId>C11</sc:typeId>
       <sc:typeName>BrønnpKollVæske</sc:typeName>
      </sc:Property>
      <sc:Property>
       <sc:name>energibrønn</sc:name>
       <sc:id>C1_14</sc:id>
       <sc:cardinality>0..1</sc:cardinality>
       <sc:sequenceNumber>14</sc:sequenceNumber>
       <sc:typeId>C9</sc:typeId>
       <sc:typeName>Link</sc:typeName>
      </sc:Property>
      <sc:Property>
       <sc:name>rapport-HTML</sc:name>
       <sc:id>C1_15</sc:id>
       <sc:cardinality>0..1</sc:cardinality>
       <sc:sequenceNumber>15</sc:sequenceNumber>
       <sc:typeId>C9</sc:typeId>
       <sc:typeName>Link</sc:typeName>
      </sc:Property>
      <sc:Property>
       <sc:name>rapport-JSON</sc:name>
       <sc:id>C1_16</sc:id>
       <sc:cardinality>0..1</sc:cardinality>
       <sc:sequenceNumber>16</sc:sequenceNumber>
       <sc:typeId>C9</sc:typeId>
       <sc:typeName>Link</sc:typeName>
      </sc:Property>
     </sc:properties>
    </sc:Class>
    <sc:Class>
     <sc:name>EnergiBrønn</sc:name>
     <sc:id>C2</sc:id>
     <sc:stereotypes>
      <sc:Stereotype>featuretype</sc:Stereotype>
     </sc:stereotypes>
     <sc:descriptors>
      <sc:documentation>
       <sc:descriptorValues>
        <sc:DescriptorValue>Grunnvannborehull som helt eller delvis er dedikert for uttak eller deponering av grunnvarme, enten gjennom kollektorslanger eller pumping av grunnvann hvis temperatur benyttes til oppvarming eller avkjøling.</sc:DescriptorValue>
       </sc:descriptorValues>
      </sc:documentation>
     </sc:descriptors>
     <sc:properties>
      <sc:Property>
       <sc:name>geometry</sc:name>
       <sc:id>C2_1</sc:id>
       <sc:cardinality>1</sc:cardinality>
       <sc:sequenceNumber>1</sc:sequenceNumber>
       <sc:typeName>GM_Point</sc:typeName>
      </sc:Property>
      <sc:Property>
       <sc:name>datauttaksdato</sc:name>
       <sc:id>C2_2</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Dato for uttak fra en database&lt;br/&gt;Merknad:&lt;br/&gt;Skiller seg fra Kopidato ved at en ikke skiller på om det er uttak fra en originaldatabase eller en kopidatabase.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:cardinality>1</sc:cardinality>
       <sc:sequenceNumber>2</sc:sequenceNumber>
       <sc:typeName>DateTime</sc:typeName>
      </sc:Property>
      <sc:Property>
       <sc:name>brønnNr</sc:name>
       <sc:id>C2_3</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Brønnummer i NGUs database</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:cardinality>1</sc:cardinality>
       <sc:sequenceNumber>3</sc:sequenceNumber>
       <sc:typeName>Integer</sc:typeName>
      </sc:Property>
      <sc:Property>
       <sc:name>geolMedium</sc:name>
       <sc:id>C2_4</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Definerer om et borehull er boret slik at den blir permanent åpen; et stykke ned i fjellgrunnen (fjell) eller kun i løsmasser (løsmasse).</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:cardinality>1</sc:cardinality>
       <sc:sequenceNumber>4</sc:sequenceNumber>
       <sc:typeId>C10</sc:typeId>
       <sc:typeName>GeolMedium</sc:typeName>
      </sc:Property>
      <sc:Property>
       <sc:name>stedfestelseMetodeInfo</sc:name>
       <sc:id>C2_5</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Stedfestelsesmetode, for eksempel GPS, kart med flere. Fram til ca 2000 finnes en del registreringer som avviker betydelig fra brønnhullets reelle koordinater.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:cardinality>1</sc:cardinality>
       <sc:sequenceNumber>5</sc:sequenceNumber>
       <sc:typeName>CharacterString</sc:typeName>
      </sc:Property>
      <sc:Property>
       <sc:name>oppdragstaker</sc:name>
       <sc:id>C2_6</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Navn på borefirma som har utført boringen</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:cardinality>1</sc:cardinality>
       <sc:sequenceNumber>6</sc:sequenceNumber>
       <sc:typeName>CharacterString</sc:typeName>
      </sc:Property>
      <sc:Property>
       <sc:name>brønnBrukOmfang</sc:name>
       <sc:id>C2_7</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Hvor omfattende vannforsyningen er (til enkelthusholdning, gårdsbruk osv.)</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:cardinality>0..1</sc:cardinality>
       <sc:sequenceNumber>7</sc:sequenceNumber>
       <sc:typeId>C12</sc:typeId>
       <sc:typeName>BrønnBrukOmfang</sc:typeName>
      </sc:Property>
      <sc:Property>
       <sc:name>boreDato</sc:name>
       <sc:id>C2_8</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Dato for boringen</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:cardinality>0..1</sc:cardinality>
       <sc:sequenceNumber>8</sc:sequenceNumber>
       <sc:typeName>Date</sc:typeName>
      </sc:Property>
      <sc:Property>
       <sc:name>konsulentFirma</sc:name>
       <sc:id>C2_9</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Konsulentfirma, som for eksempel har valgt ut borelokalitet, eller som har utredet aspekter ved bruk av brønnen.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:cardinality>0..1</sc:cardinality>
       <sc:sequenceNumber>9</sc:sequenceNumber>
       <sc:typeName>CharacterString</sc:typeName>
      </sc:Property>
      <sc:Property>
       <sc:name>boretLengde</sc:name>
       <sc:id>C2_10</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Total lengde av borehullets forløp, tilsvarer dyp ved vertikal boring</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:cardinality>0..1</sc:cardinality>
       <sc:sequenceNumber>10</sc:sequenceNumber>
       <sc:typeName>Real</sc:typeName>
      </sc:Property>
      <sc:Property>
       <sc:name>boretLengdeTilBerg</sc:name>
       <sc:id>C2_11</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Dybde til berg som ikke er målt men basert på tolkning</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:cardinality>0..1</sc:cardinality>
       <sc:sequenceNumber>11</sc:sequenceNumber>
       <sc:typeName>Real</sc:typeName>
      </sc:Property>
      <sc:Property>
       <sc:name>vannstandBorehull</sc:name>
       <sc:id>C2_12</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Stabil vannstand etter boring målt fra overflaten i meter.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:cardinality>0..1</sc:cardinality>
       <sc:sequenceNumber>12</sc:sequenceNumber>
       <sc:typeName>Real</sc:typeName>
      </sc:Property>
      <sc:Property>
       <sc:name>datoVannstandBorehull</sc:name>
       <sc:id>C2_13</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Dato for når vannstand etter boring er målt  (før eventuell kapasitetsøkning).</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:cardinality>0..1</sc:cardinality>
       <sc:sequenceNumber>13</sc:sequenceNumber>
       <sc:typeName>Date</sc:typeName>
      </sc:Property>
      <sc:Property>
       <sc:name>brønnHelningType</sc:name>
       <sc:id>C2_14</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Hvilken type helning borehullet kan ha (grovinndeling)</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:cardinality>0..1</sc:cardinality>
       <sc:sequenceNumber>14</sc:sequenceNumber>
       <sc:typeId>C13</sc:typeId>
       <sc:typeName>BrønnHelningType</sc:typeName>
      </sc:Property>
      <sc:Property>
       <sc:name>diameterBorehull</sc:name>
       <sc:id>C2_15</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Borehullets diameter målt i millimeter. For fjellbrønner oppgis dominerende diameter på borhullet nedenfor foringsrørets avslutning.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:cardinality>0..1</sc:cardinality>
       <sc:sequenceNumber>15</sc:sequenceNumber>
       <sc:typeName>Integer</sc:typeName>
      </sc:Property>
      <sc:Property>
       <sc:name>boretHelningsgrad</sc:name>
       <sc:id>C2_16</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Borehullets hellning målt som avvik i grader fra loddlinje</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:cardinality>0..1</sc:cardinality>
       <sc:sequenceNumber>16</sc:sequenceNumber>
       <sc:typeName>Integer</sc:typeName>
      </sc:Property>
      <sc:Property>
       <sc:name>boretAzimuth</sc:name>
       <sc:id>C2_17</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Helning hvor  90 grader er vertikalt , 0 grader er horisontalt</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:cardinality>0..1</sc:cardinality>
       <sc:sequenceNumber>17</sc:sequenceNumber>
       <sc:typeName>Integer</sc:typeName>
      </sc:Property>
      <sc:Property>
       <sc:name>materialForingsrør</sc:name>
       <sc:id>C2_18</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Foringsrørets materialtype</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:cardinality>0..1</sc:cardinality>
       <sc:sequenceNumber>18</sc:sequenceNumber>
       <sc:typeId>C14</sc:typeId>
       <sc:typeName>MaterialForingsrør</sc:typeName>
      </sc:Property>
      <sc:Property>
       <sc:name>lengdeForingsrør</sc:name>
       <sc:id>C2_19</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Foringsrørets lengde i meter</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:cardinality>0..1</sc:cardinality>
       <sc:sequenceNumber>19</sc:sequenceNumber>
       <sc:typeName>Real</sc:typeName>
      </sc:Property>
      <sc:Property>
       <sc:name>boretKapasitet</sc:name>
       <sc:id>C2_20</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Brønnens kapasitet ("vannføring") i liter/time før eventuell kapsitetsøkende trykking eller sprengning. Vanligvis målt nokså usikkert av boreren i forbindelse med selve boringen.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:cardinality>0..1</sc:cardinality>
       <sc:sequenceNumber>20</sc:sequenceNumber>
       <sc:typeName>Real</sc:typeName>
      </sc:Property>
      <sc:Property>
       <sc:name>kapasMålemet</sc:name>
       <sc:id>C2_21</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Beskriver målemetode brukt for å måle brønnens kapasitet (vanngiverevne). Hvis brønnen senere er trykket eller sprengt for å øke kapasiteten,  oppgis her den målemetoden som er brukt FØR denne kapasitetsøkningen.</sc:DescriptorValue>
