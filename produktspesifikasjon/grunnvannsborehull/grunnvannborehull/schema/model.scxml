       <sc:sequenceNumber>1</sc:sequenceNumber>
       <sc:typeName>GM_Point</sc:typeName>
      </sc:Property>
      <sc:Property>
       <sc:name>datauttaksdato</sc:name>
       <sc:id>C8_2</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Dato for uttak fra en database&lt;br/&gt;Merknad:&lt;br/&gt;Skiller seg fra Kopidato ved at en ikke skiller på om det er uttak fra en originaldatabase eller en kopidatabase.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:cardinality>1</sc:cardinality>
       <sc:sequenceNumber>2</sc:sequenceNumber>
