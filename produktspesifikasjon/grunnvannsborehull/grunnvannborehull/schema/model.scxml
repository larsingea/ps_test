       <sc:id>C5_27</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Hvor hyppig det blir utført målinger/ kjemiske analyser</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:cardinality>0..1</sc:cardinality>
       <sc:sequenceNumber>27</sc:sequenceNumber>
