         <sc:descriptorValues>
          <sc:DescriptorValue>Forklaring til objektet og undersøkelser utført på lokaliteten.
Brønnborers generelle kommentarer til boringen, gitt på brønnskjema</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:cardinality>0..1</sc:cardinality>
