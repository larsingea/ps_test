  "dataCaptureAndProductionSection": {
    "DataAcquisitionAndProcessing": {
      "processStep": [
        {
          "description": "Datafangsten er basert på innholdet i et brønnskjema som primært brønnborefirmaene leverer når det bores en brønn. Forskrift om oppgaveplikt ved brønnboring og grunnvannsundersøkelser trådte i kraft 1. januar 1997 og omfatter rapporteringsplikt til NGU. De innrapporterte brønndataene blir deretter kvalitetssikret av NGU, og er deretter tilgjengelig i karttjenester og som nedlastbart datasett umiddelbart."
        }
      ]
    }
  },
