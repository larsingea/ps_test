@startuml
' For wide diagrams, render with: plantuml -DPLANTUML_LIMIT_SIZE=16384 ...
' The 'scale max' directive below caps the rendered output to prevent the
' default PlantUML 4096px size limit from cropping the diagram.
scale max 4000*4000

title Kulturminner - Kulturmiljøer - Kulturminner - Kulturmiljøer - Objekttyper

skinparam backgroundColor #F5F5F5
skinparam shadowing false
skinparam RoundCorner 6
skinparam ArrowColor #6C8198
skinparam wrapWidth 200
skinparam class {
  BackgroundColor #FBF2E8
  BorderColor #9C8578
  FontColor #2D201A
  HeaderBackgroundColor #EFE1D6
  HeaderFontColor #2D201A
  AttributeIconSize 0
}
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #6C8198
  FontColor #2D201A
}
skinparam stereotypeCBackgroundColor #EAD9CE
skinparam stereotypeCBorderColor #9C8578
skinparam stereotypeCFontColor #2D201A

package "Objekttyper" {

  class Kulturmiljoer <<featureType>> {
    + datafangstdato [0..1] : DateTime
    + forsteDigitaliseringsdato [0..1] : DateTime
    + id [0..1] : CharacterString
    + informasjon [0..1] : CharacterString
    + kommune [0..1] : CharacterString
    + kulturmiljoId [0..1] : CharacterString
    + kulturmiljokategori [0..1] : CharacterString
    + lokalId [0..1] : CharacterString
    + malemetode [0..1] : Integer
    + navn [0..1] : CharacterString
    + navnerom [0..1] : CharacterString
    + noyaktighet [0..1] : Integer
    + oppdateringsdato [0..1] : DateTime
    + opphav [0..1] : CharacterString
    + vernedato [0..1] : DateTime
    + vernelov [0..1] : CharacterString
    + verneparagraf [0..1] : CharacterString
    + vernetype [0..1] : CharacterString
    + versjonId [0..1] : CharacterString

    ..Geometri..
    + geometry [1] : GM_Object
  }

  class Askeladden {
  }

  class Kulturminnesok {
  }
}

  Kulturmiljoer --> Askeladden : askeladden [0..1]
  Kulturmiljoer --> Kulturminnesok : kulturminnesok [0..1]

@enduml
