       <sc:name>medium</sc:name>
       <sc:id>C2_7</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Objektets beliggenhet i forhold til jordoverflaten&lt;br/&gt;Eksempel:
På bro, i tunnel, inne i et bygningsmessig anlegg, etc.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
