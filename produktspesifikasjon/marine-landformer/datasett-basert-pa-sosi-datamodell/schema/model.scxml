      <sc:Property>
       <sc:name>Jord- og flomskredløp</sc:name>
       <sc:id>C8_54</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Kanal i løsmasser dannet som følge av jord- eller flomskred</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>54</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Nedslagsgrop (maringeologi)</sc:name>
       <sc:id>C8_55</sc:id>
       <sc:descriptors>
        <sc:documentation>
