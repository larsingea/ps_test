       <sc:id>C11_13</sc:id>
       <sc:sequenceNumber>13</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Avgrensning basert på geologisk observasjon i felt, prøvetaking og analyser</sc:name>
       <sc:id>C11_14</sc:id>
       <sc:sequenceNumber>14</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Tolket avgrensning basert på tilgjengelig geologisk kartlegging</sc:name>
       <sc:id>C11_15</sc:id>
       <sc:sequenceNumber>15</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Avgrensning basert på prøvetaking</sc:name>
       <sc:id>C11_16</sc:id>
       <sc:sequenceNumber>16</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Avgrensning basert på seismikk</sc:name>
       <sc:id>C11_17</sc:id>
       <sc:sequenceNumber>17</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Avgrensning basert på detaljerte dybdedata</sc:name>
       <sc:id>C11_18</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Avgrensning ved bruk av multistråleekkolodd eller interferometrisk sonar</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>18</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Avgrensning basert på backscatter data/sidescan.sonar</sc:name>
       <sc:id>C11_19</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Avgrensning basert på bunnreflektivitet/data fra sidescan.sonar</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>19</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Avgrensning basert på prøvetaking og akustiske data/metoder</sc:name>
       <sc:id>C11_20</sc:id>
       <sc:sequenceNumber>20</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Avgrensning basert på akustiske data/metoder</sc:name>
       <sc:id>C11_21</sc:id>
       <sc:sequenceNumber>21</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Avgrensning basert på flere metoder/datatyper</sc:name>
       <sc:id>C11_22</sc:id>
       <sc:sequenceNumber>22</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Avgrensning basert på undervannsfoto og/eller -video</sc:name>
       <sc:id>C11_23</sc:id>
       <sc:sequenceNumber>23</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Aavgrensning basert på akustiske data/metoder verifisert ved prøvetaking, foto o.l.</sc:name>
       <sc:id>C11_24</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Avgrensning basert på akustiske data/metoder verifisert ved prøvetaking, foto o.l.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>24</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Avgrensningen er foretatt ut fra tolkning basert på tilgjengelige batymetriske data (varierende oppløsning), litteratur og kart</sc:name>
       <sc:id>C11_25</sc:id>
