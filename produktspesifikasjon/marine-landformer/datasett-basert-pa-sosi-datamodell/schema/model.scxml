    <sc:Class>
     <sc:name>GeolPavisningstype</sc:name>
     <sc:id>C11</sc:id>
     <sc:stereotypes>
      <sc:Stereotype>codelist</sc:Stereotype>
     </sc:stereotypes>
     <sc:descriptors>
      <sc:documentation>
       <sc:descriptorValues>
        <sc:DescriptorValue>hvor sikkert et geologisk objekt er påvist i terrenget, eller hvilken metode som ligger til grunn for påvisningen/registreringen</sc:DescriptorValue>
       </sc:descriptorValues>
      </sc:documentation>
     </sc:descriptors>
     <sc:properties>
      <sc:Property>
       <sc:name>Ikke spesifisert</sc:name>
       <sc:id>C11_1</sc:id>
       <sc:sequenceNumber>1</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Sikker påvisning/observasjon</sc:name>
       <sc:id>C11_2</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Avgrensningen eller registreringen av objektet er påvist eller observert i felt</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>2</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Usikker påvisning/observasjon</sc:name>
       <sc:id>C11_3</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Ikke påvist/observert men antatt avgrensning/registrering av objekt</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>3</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Konstruert avgrensning</sc:name>
       <sc:id>C11_4</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Tilfeldig plassert avgrensning og meget usikker.  Benyttes blant annet under vann- eller breoverflater</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>4</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Geofysisk tolket grense</sc:name>
       <sc:id>C11_5</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Avgrensning basert på geofysiske indikasjoner</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>5</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Dårlig synlig avgrensning i terrenget</sc:name>
       <sc:id>C11_6</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Basert på generalisert tolkning av objekter med små innbyrdes variasjoner (f.eks. skille mellom tynt humusdekke og bart fjell, eller mellom to svært like bergarter)</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>6</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Overgangsmessig grense</sc:name>
       <sc:id>C11_7</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Glidende overgang mellom to bergarter,  jordarter o.l.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>7</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Tolket avgrensning/registrering</sc:name>
       <sc:id>C11_8</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Avgrensninger av geologisk objekt eller delobjekt fremkommet ved generalisering, samtolkning eller aggregering</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>8</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Flyfototolket objekt eller delobjekt</sc:name>
       <sc:id>C11_9</sc:id>
       <sc:sequenceNumber>9</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Observasjon med usikker geografisk beliggenhet</sc:name>
       <sc:id>C11_10</sc:id>
       <sc:sequenceNumber>10</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Avgrensning ikke basert på geologi</sc:name>
       <sc:id>C11_11</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Der f.eks. en administrativ grense eller kystkontur har bidratt til avgrensning av et geologisk objekt</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>11</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Avgrensning basert på geofysiske data/metoder verifisert ved prøvetaking</sc:name>
       <sc:id>C11_12</sc:id>
       <sc:sequenceNumber>12</sc:sequenceNumber>
      </sc:Property>
