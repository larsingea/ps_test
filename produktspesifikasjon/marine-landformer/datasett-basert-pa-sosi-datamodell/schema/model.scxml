         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>52</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Skredkant</sc:name>
       <sc:id>C8_53</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Bratt skrent som markerer løsnekant av et skred. Kan være dannet av forskjellige typer skred i både løsmasser og fast fjell.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>53</sc:sequenceNumber>
