   <sc:classes>
    <sc:Class>
     <sc:name>Identifikasjon</sc:name>
     <sc:id>C6</sc:id>
     <sc:stereotypes>
      <sc:Stereotype>datatype</sc:Stereotype>
     </sc:stereotypes>
     <sc:properties>
      <sc:Property>
       <sc:name>lokalId</sc:name>
       <sc:id>C6_1</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>lokal identifikator, tildelt av dataleverendør/dataforvalter. Den lokale identifikatoren er unik innenfor navnerommet, ingen andre objekter har samme identifikator.

NOTE: Det er data leverendørens ansvar å sørge for at denne lokale identifikatoren er unik innenfor navnerommet.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:taggedValues>
        <sc:TaggedValue>
         <sc:name>SOSI_navn</sc:name>
         <sc:values>
          <sc:Value>LOKALID</sc:Value>
         </sc:values>
        </sc:TaggedValue>
       </sc:taggedValues>
       <sc:cardinality>1</sc:cardinality>
       <sc:sequenceNumber>1</sc:sequenceNumber>
       <sc:typeName>CharacterString</sc:typeName>
      </sc:Property>
      <sc:Property>
       <sc:name>navnerom</sc:name>
       <sc:id>C6_2</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>navnerom som unikt identifiserer datakilden til objektet, starter med to bokstavs kode jfr ISO 3166. Benytter understreking  ("_") dersom data produsenten ikke er assosiert med bare et land.

NOTE 1 : Verdien for nanverom vil eies av den dataprodusent som har ansvar for de unike identifikatorene og vil registreres i "INSPIRE external  Object Identifier Namespaces Register"

Eksempel: NO for Norge.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:taggedValues>
        <sc:TaggedValue>
         <sc:name>SOSI_navn</sc:name>
         <sc:values>
          <sc:Value>NAVNEROM</sc:Value>
         </sc:values>
        </sc:TaggedValue>
       </sc:taggedValues>
       <sc:cardinality>1</sc:cardinality>
       <sc:sequenceNumber>2</sc:sequenceNumber>
       <sc:typeName>CharacterString</sc:typeName>
      </sc:Property>
      <sc:Property>
       <sc:name>versjonId</sc:name>
       <sc:id>C6_3</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>identifikasjon av en spesiell versjon av et geografisk objekt (instans), maksimum lengde på 25 karakterers. Dersom spesifikasjonen av et geografisk objekt med en identifikasjon inkludererer livsløpssyklusinformasjon, benyttes denne versjonId for å skille mellom ulike versjoner av samme objekt. versjonId er en unik  identifikasjon av versjonen.

NOTE Maksimum lengde er valgt for å tillate tidsregistrering i henhold til  ISO 8601, slik som  "2007-02-12T12:12:12+05:30" som versjonId.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:taggedValues>
        <sc:TaggedValue>
         <sc:name>SOSI_navn</sc:name>
         <sc:values>
          <sc:Value>VERSJONID</sc:Value>
         </sc:values>
        </sc:TaggedValue>
       </sc:taggedValues>
       <sc:cardinality>1</sc:cardinality>
       <sc:sequenceNumber>3</sc:sequenceNumber>
       <sc:typeName>CharacterString</sc:typeName>
      </sc:Property>
     </sc:properties>
    </sc:Class>
    <sc:Class>
     <sc:name>Posisjonskvalitet</sc:name>
     <sc:id>C7</sc:id>
     <sc:stereotypes>
      <sc:Stereotype>datatype</sc:Stereotype>
     </sc:stereotypes>
     <sc:properties>
      <sc:Property>
       <sc:name>målemetode</sc:name>
       <sc:id>C7_1</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>metode for måling i grunnriss (x,y), og høyde (z) når metoden er den samme som ved måling i grunnriss</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:cardinality>1</sc:cardinality>
       <sc:sequenceNumber>1</sc:sequenceNumber>
       <sc:typeId>C9</sc:typeId>
       <sc:typeName>Målemetode</sc:typeName>
      </sc:Property>
      <sc:Property>
       <sc:name>målemetodeNavn</sc:name>
       <sc:id>C7_2</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>navn på metode for måling i grunnriss (x,y), og høyde (z) når metoden er den samme som ved måling i grunnriss</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:taggedValues>
        <sc:TaggedValue>
         <sc:name>SOSI_navn</sc:name>
         <sc:values>
          <sc:Value>MÅLEMETODENAVN</sc:Value>
         </sc:values>
        </sc:TaggedValue>
       </sc:taggedValues>
       <sc:cardinality>1</sc:cardinality>
       <sc:sequenceNumber>2</sc:sequenceNumber>
       <sc:typeName>CharacterString</sc:typeName>
      </sc:Property>
      <sc:Property>
       <sc:name>nøyaktighet</sc:name>
       <sc:id>C7_3</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>punktstandardavviket i grunnriss for punkter samt tverravvik for linjer

Merknad:
Oppgitt i cm</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:taggedValues>
        <sc:TaggedValue>
         <sc:name>SOSI_navn</sc:name>
         <sc:values>
          <sc:Value>NØYAKTIGHET</sc:Value>
         </sc:values>
        </sc:TaggedValue>
       </sc:taggedValues>
       <sc:cardinality>0..1</sc:cardinality>
       <sc:sequenceNumber>3</sc:sequenceNumber>
       <sc:typeName>Integer</sc:typeName>
      </sc:Property>
     </sc:properties>
    </sc:Class>
    <sc:Class>
     <sc:name>KvFormLinjetype</sc:name>
     <sc:id>C8</sc:id>
     <sc:stereotypes>
      <sc:Stereotype>codelist</sc:Stereotype>
     </sc:stereotypes>
     <sc:descriptors>
      <sc:documentation>
       <sc:descriptorValues>
        <sc:DescriptorValue>kvartærgeologiske formelementlinjer

Merknad: Linjetema på kvartærgeologiske kart. Viser former skapt under isavsmeltingen, elve-/bekkeformer, strandformer eller skredformer mm. Ved flere av linjesymbolene må en ta hensyn til digitaliseringsretningen for å få symbolet riktig</sc:DescriptorValue>
       </sc:descriptorValues>
      </sc:documentation>
     </sc:descriptors>
     <sc:properties>
      <sc:Property>
       <sc:name>Ikke angitt</sc:name>
       <sc:id>C8_1</sc:id>
       <sc:sequenceNumber>1</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Drumlin</sc:name>
       <sc:id>C8_2</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Strømlinjeformet rygg i løsmasser og/eller berggrunn, orientert parallelt med isbevegelsesretningen. Hvis løsmasseryggen er akkumulert i le av oppstikkende berggrunn kan formen kalles knaus og hale.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>2</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Drumlinoid rygg</sc:name>
       <sc:id>C8_3</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Utydelig strømlinjeformet rygg i løsmasser og/eller berggrunn, orientert parallelt med isbevegelsesretningen. Hvis løsmasseryggen er akkumulert i le av oppstikkende berggrunn kan formen kalles knaus og hale.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>3</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Randmorene</sc:name>
       <sc:id>C8_4</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Ryggformet moreneavsetning dannet langs ytterkanten av en bre. Omfatter ende- og sidemorener.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>4</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Parallelle rygger og furer i overflaten</sc:name>
       <sc:id>C8_5</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Langstrakte strømlinjeformede rygger og furer i overflaten. Formene er orientert parallelt med tidligere isbevegelsesretning og er dannet under en isbre. Lavt relieff og liten bredde i forhold til lengde.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>5</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Sprekkefyllrygg</sc:name>
       <sc:id>C8_6</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Ryggform som dannes ved at løsmasser blir presset opp i sprekk i sålen av en isbre. Forbindes med stagnasjon av breen.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>6</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Tilbaketrekningsmorene</sc:name>
       <sc:id>C8_7</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Morenerygger avsatt foran breen ved lite fremstøt eller stillstand av brefronten, i en periode med generell tilbaketrekning av breen</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>7</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Morenerygg</sc:name>
       <sc:id>C8_8</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Ryggformet moreneavsetning</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>8</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Esker (ryggformet breelvavsetning)</sc:name>
       <sc:id>C8_9</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Klar ryggform i løsmasser. Angir at materialet er avsatt i tunneler eller sprekker i eller under en bre. Dersom den ryggformete breelvavsetningen er stor nok til å danne figur på kartet brukes fargen for breelvavsetninger til å angi utbredelsen og eskersymbolet til å angi ryggformen.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>9</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Breelvnedskjæring</sc:name>
       <sc:id>C8_10</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Erosjonskant dannet av breelv</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>10</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Bre-lateralt smeltevannsløp (spylerenne, venstre side) (2)</sc:name>
       <sc:id>C8_11</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Smeltevannsløp dannet langs kanten av en bre (venstre side)</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>11</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Smeltevannsløp (spylerenne)</sc:name>
       <sc:id>C8_12</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Kanal i løsmasser dannet av smeltevann fra isbreer</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>12</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Bre-lateralt smeltevannsløp (spylerenne, høyre side) (1)</sc:name>
       <sc:id>C8_13</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Smeltevannsløp dannet langs kanten av en bre (høyre side)</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>13</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Smeltevannsløp over passpunkt</sc:name>
       <sc:id>C8_14</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Smeltevannsspor dannet ved overløp mellom to høyder (passpunkt)</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>14</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Side av smeltevannsgjel (1)</sc:name>
       <sc:id>C8_15</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Tørrlagt gjel utformet i fast fjell av smeltevann fra en isbre (venstre side)</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>15</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Side av smeltevannsgjel (2)</sc:name>
       <sc:id>C8_16</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Tørrlagt gjel utformet i fast fjell av smeltevann fra en isbre (høyre side)</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>16</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Smeltevannsgjel</sc:name>
       <sc:id>C8_17</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Tørrlagt gjel, utformet i fast fjell av smeltevann fra en isbre</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>17</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Spylefelt</sc:name>
       <sc:id>C8_18</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Fjelloverflate avspylt av smeltevann fra en isbre</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>18</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Iskontaktskråning</sc:name>
       <sc:id>C8_19</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Bratt skråning utformet i løsmasser avsatt med støtte mot en brekant</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>19</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Strandlinje fra bredemt sjø</sc:name>
       <sc:id>C8_20</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Horisontal linje i landskapet som markerer ytterkanten av en tidligere bredemt sjø. Kan være utformet både i løsmasser og i fast fjell. Blir også kalt sete.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>20</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Strandvoll fra bredemt sjø</sc:name>
       <sc:id>C8_21</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Voll av sorterte løsmasser. Dannet av bølgeaktivitet langs strandsonen i en bredemt sjø.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>21</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Pløyespor fra isfjell</sc:name>
       <sc:id>C8_22</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Avlange grøfter i løsmasser. Dannet av drivende isfjell i kontakt med bunnen av hav eller innsjø.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>22</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Stor dødisgrop</sc:name>
       <sc:id>C8_23</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Stor forsenkning i løsmasser. Dannet ved smelting av begravde isrester. Kalles også grytehull.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>23</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Grop dannet av isfjell</sc:name>
       <sc:id>C8_24</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Forsenkning i løsmasser. Dannet ved at et grunnstøtt isfjell blir liggende i ro.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>24</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Breelvvifte</sc:name>
       <sc:id>C8_25</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Vifteformet løsmasseavsetning, hovedsaklig formet av rennende smeltevann fra en isbre.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>25</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Nivasjonskant</sc:name>
       <sc:id>C8_26</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Skrent dannet i bakkant av snøleie</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>26</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Terrassekant, glasial</sc:name>
       <sc:id>C8_27</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Bratt kant/skråning som avgrenser en terrasseflate i sorterte løsmasser. Dannet i brenært miljø.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>27</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Glasitektonisk skrent</sc:name>
       <sc:id>C8_28</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Bratt skråning dannet der en isbre har dratt med seg et flak av underlaget</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>28</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Elve-/bekkenedskjæring</sc:name>
       <sc:id>C8_29</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Kant dannet av rennende vann som har erodert ned i underlaget</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>29</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Tidligere elve-/bekkeløp</sc:name>
       <sc:id>C8_30</sc:id>
       <sc:descriptors>
        <sc:documentation>
