       </sc:descriptors>
       <sc:sequenceNumber>45</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Strandlinje utformet i fastFjell</sc:name>
       <sc:id>C8_46</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
