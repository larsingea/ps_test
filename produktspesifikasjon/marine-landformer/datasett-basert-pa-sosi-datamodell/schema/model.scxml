         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>48</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Skredløp, tydelig</sc:name>
       <sc:id>C8_49</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Kanal i bratt skråning dannet av gjentatte skred av forskjellig type (snøskred, jordskred, steinsprang)</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
