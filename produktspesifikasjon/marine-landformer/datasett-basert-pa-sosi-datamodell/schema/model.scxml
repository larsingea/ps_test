       </sc:descriptors>
       <sc:sequenceNumber>55</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Skredkant, flak (maringeologi)</sc:name>
       <sc:id>C8_56</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Bakkant av flakformet skred på sjøbunnen</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>56</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Skredfront (maringeologi)</sc:name>
       <sc:id>C8_57</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Front av et løsmasseskred. Viser utstrekning av en skredvifte på sjøbunnen.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>57</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Snøskredløp</sc:name>
       <sc:id>C8_58</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Tydelig løp, erodert gjennom gjentatte snøskred</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>58</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Jord- og flomskredslevée</sc:name>
       <sc:id>C8_59</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Små rygger langs jord- og flomskredløp</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>59</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Skrederosjonskant</sc:name>
       <sc:id>C8_60</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Kant i løsmassedekket langs skredløp. Dannet av gjentatte skred langs samme løp.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>60</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Steinstriper</sc:name>
       <sc:id>C8_61</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Rekker av steiner orientert nedover en skråning grunnet gjentatte fryse- og tineprosesser. Fremstår som striper nedover fjellsider.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>61</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Rygg</sc:name>
       <sc:id>C8_62</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Ryggform i løsmasser. Primært brukt for rygger dannet ved avsetning eller deformasjon, ikke for ryggformer som har oppstått som følge av erosjon.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>62</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Deflasjonsgrop</sc:name>
       <sc:id>C8_63</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Fordypning i løsmasser dannet ved vinderosjon. Kan være flere meter bred og dyp.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>63</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Markert haug eller rygg</sc:name>
       <sc:id>C8_64</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Avgrensning av en enkelt haug eller rygg i løsmasser</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>64</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Nedskjæring i løsmasser (maringeologi)</sc:name>
       <sc:id>C8_65</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Nedskjæring i løsmasser</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>65</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Lineament (maringeologi)</sc:name>
       <sc:id>C8_66</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Regionalt utstrakt, linjeformet landskapstrekk som antas å avspeile svakhetsstrukturer eller inhomogeniteter i jordskorpen</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>66</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Sandbølge (maringeologi)</sc:name>
       <sc:id>C8_67</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Sandbølge eller sanddyne dannet av strømmende vann eller vind</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>67</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Kildehorisont</sc:name>
       <sc:id>C8_68</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Horisont med grunnvannsutslag</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>68</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Forkastningslinje med antatt glasial og/eller postglasial aktivitet</sc:name>
       <sc:id>C8_69</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Rettlinjet form i landoverflaten, som oftest synlig som en bratt skrent. Tolket som en forkastning med antatt aktivitet i glasial eller postglasial tid, basert på påvist deformasjon og skred/utglidninger av glasiale eller postglasiale løsmasser.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>69</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Glasitektonisk haug (maringeologi)</sc:name>
       <sc:id>C8_70</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Haug- og ryggformet terreng som dannes når isbreen drar med seg og senere legger igjen store flak av underlaget</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>70</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Glasitektonisk grop (maringeologi)</sc:name>
       <sc:id>C8_71</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Forsenkning som dannes når isbreen beveger seg framover underlaget og drar med seg store flak av underlaget</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>71</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Rygg, uspesifisert (maringeologi)</sc:name>
       <sc:id>C8_72</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Rygg, uspesifisert</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>72</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Strømrenne (maringeologi)</sc:name>
       <sc:id>C8_73</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Renner på havbunnen dannet av bunnstrømmer</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>73</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Renne, uspesifisert (maringeologi)</sc:name>
       <sc:id>C8_74</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Renne, uspesifisert</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>74</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Sedimentbølge (maringeologi)</sc:name>
       <sc:id>C8_75</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Stor, bølgelignende landform på havbunnen dannet av bunnstrømmer. Toppen av bølgen er vanligvis orientert vinkelrett på strømretningen. Sedimentbølger består oftest av en blanding av slam, silt og sand, men kan og inneholde grus.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>75</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Korallrev (maringeologi)</sc:name>
       <sc:id>C8_76</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Korallrev</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>76</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Forkastning (maringeologi)</sc:name>
       <sc:id>C8_77</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Bruddflate der det har foregått målbar/visuell forskyving av bergartene. Bevegelsesretningen på forskyvningen mellom forkastningsblokkene definerer betegnelsen for forkastningstypen, deriblant normal-, revers-, skrå- og sidelengsforkastning.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>77</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Sprekk (maringeologi)</sc:name>
       <sc:id>C8_78</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Smal fordypning i havbunnen, som dannes ved nedsynkning av sedimenter pga. forkastning, utslipp av gass fra oppløsning av gasshydrater, eller svekket stabilitet av skråning etter utglidning av et skred.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>78</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Kant, uspesifisert (maringeologi)</sc:name>
       <sc:id>C8_79</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Kant av usikker opprinnelse i løsmasser (f.eks. pga. skred, strøm eller en kombinasjon)</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:sequenceNumber>79</sc:sequenceNumber>
      </sc:Property>
      <sc:Property>
       <sc:name>Ankerspor (maringeologi)</sc:name>
       <sc:id>C8_80</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Ankerspor på sjøbunnen</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
