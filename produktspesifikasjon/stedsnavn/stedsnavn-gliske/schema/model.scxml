   <sc:classes>
    <sc:Class>
     <sc:name>Stedsnavn</sc:name>
     <sc:id>C1</sc:id>
     <sc:stereotypes>
      <sc:Stereotype>featuretype</sc:Stereotype>
     </sc:stereotypes>
     <sc:descriptors>
      <sc:documentation>
       <sc:descriptorValues>
        <sc:DescriptorValue>Navn på et sted, med posisjon og navneformer på norsk, samisk og gælisk.</sc:DescriptorValue>
       </sc:descriptorValues>
      </sc:documentation>
     </sc:descriptors>
     <sc:properties>
      <sc:Property>
       <sc:name>posisjon</sc:name>
       <sc:id>C1_1</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Punkt som angir stedets plassering.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:cardinality>1</sc:cardinality>
       <sc:sequenceNumber>1</sc:sequenceNumber>
       <sc:typeName>GM_Point</sc:typeName>
      </sc:Property>
      <sc:Property>
       <sc:name>norskNavn</sc:name>
       <sc:id>C1_2</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Stedsnavnets skrivemåte på norsk.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:cardinality>0..1</sc:cardinality>
       <sc:sequenceNumber>2</sc:sequenceNumber>
       <sc:typeName>CharacterString</sc:typeName>
      </sc:Property>
      <sc:Property>
       <sc:name>samiskNavn</sc:name>
       <sc:id>C1_3</sc:id>
       <sc:descriptors>
        <sc:documentation>
         <sc:descriptorValues>
          <sc:DescriptorValue>Stedsnavnets skrivemåte på samisk.</sc:DescriptorValue>
         </sc:descriptorValues>
        </sc:documentation>
       </sc:descriptors>
       <sc:cardinality>0..1</sc:cardinality>
       <sc:sequenceNumber>3</sc:sequenceNumber>
       <sc:typeName>CharacterString</sc:typeName>
      </sc:Property>
      <sc:Property>
       <sc:name>gaeliskNavn</sc:name>
       <sc:id>C1_4</sc:id>
       <sc:descriptors>
